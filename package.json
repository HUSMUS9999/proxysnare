{
  "name": "proxysnare",
  "version": "1.0.0",
  "description": "Zero-dependency HTTP Repeater & Intercepting Proxy defense (Proof-of-Freshness HMAC-SHA256 + rotating honey-canary middleware, reverse proxy, browser guard, and Python stdlib verifier)",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./detector": "./src/detector.js",
    "./middleware": "./src/middleware.js",
    "./browser-guard": "./src/browser-guard.js",
    "./nl": "./src/nl.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "bin/",
    "python/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "proxysnare": "./bin/proxysnare.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HUSMUS9999/proxysnare.git"
  },
  "homepage": "https://github.com/HUSMUS9999/proxysnare#readme",
  "bugs": {
    "url": "https://github.com/HUSMUS9999/proxysnare/issues"
  },
  "scripts": {
    "test": "node --test test/proxysnare.test.js",
    "demo": "node bin/proxysnare.js demo",
    "bench": "node benchmarks/run_unbiased_benchmark.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "security",
    "burp-suite",
    "caido",
    "repeater",
    "proxy-detection",
    "anti-replay",
    "http-security",
    "middleware"
  ],
  "license": "MIT"
}
