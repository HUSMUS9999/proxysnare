{
  "name": "proxysnare",
  "version": "2.0.0",
  "description": "Zero-dependency HTTP Repeater & Intercepting Proxy defense (PS_ECDH_V2 ephemeral P-256 ECDH + HKDF-SHA256, boot-token PoW, Proof-of-Freshness HMAC-SHA256 + rotating honey-canary middleware, reverse proxy, browser guard, and Python stdlib verifier)",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./detector": {
      "types": "./src/detector.d.ts",
      "default": "./src/detector.js"
    },
    "./middleware": {
      "types": "./src/middleware.d.ts",
      "default": "./src/middleware.js"
    },
    "./browser-guard": {
      "types": "./src/browser-guard.d.ts",
      "default": "./src/browser-guard.js"
    },
    "./nl": {
      "types": "./src/nl.d.ts",
      "default": "./src/nl.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "bin/",
    "python/",
    "!python/__pycache__/**",
    "!**/*.pyc",
    "docs/",
    "assets/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "proxysnare": "./bin/proxysnare.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HUSMUS9999/proxysnare.git"
  },
  "homepage": "https://github.com/HUSMUS9999/proxysnare#readme",
  "bugs": {
    "url": "https://github.com/HUSMUS9999/proxysnare/issues"
  },
  "scripts": {
    "test": "node --test test/proxysnare.test.js",
    "demo": "node bin/proxysnare.js demo",
    "bench": "node benchmarks/run_unbiased_benchmark.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "security",
    "burp-suite",
    "caido",
    "repeater",
    "proxy-detection",
    "anti-replay",
    "ecdh",
    "http-security",
    "middleware"
  ],
  "license": "MIT"
}
